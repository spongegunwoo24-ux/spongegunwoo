{
  "manifest_version": 3,
  "name": "공부 타이머 사이트 차단기",
  "version": "1.0",
  "description": "일일플래너의 타이머가 실행 중이거나 잠금모드가 켜져 있을 때 지정한 사이트(유튜브, 틱톡 등)를 자동으로 차단합니다.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "공부 타이머 사이트 차단기"
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
